    "//isPowerOfTwo or not? \n",
    "\n",
    "Scanner sc = new Scanner(System.in);\n",
    "int n = sc.nextInt();\n",
    "if( n > 0 && (n & (n-1)) == 0){\n",
    "    System.out.println(\"True\");\n",
    "}else{\n",
    "    System.out.println(\"False\");\n",
    "}"
   ]
