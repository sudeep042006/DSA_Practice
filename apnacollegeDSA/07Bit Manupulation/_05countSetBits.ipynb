   "source": [
    "//count set bits in the no. like 10 -> 1010 so it will be 2 because there are two 1's\n",
    "Scanner sc = new Scanner(System.in);\n",
    "int count = 0;\n",
    "int n = sc.nextInt();\n",
    "while(n > 0){\n",
    "    if((n & 1) != 0){\n",
    "        count++;\n",
    "    }\n",
    "    n = n>>1;\n",
    "}\n",
    "\n",
    "System.out.println(count);"
   ]
